{
  "version": 2,
  "mode": "free_exploration",
  "levels": [
    {
      "id": "L1",
      "name": "便民店初访",
      "music": "I3_BGM_NightShift_Main",
      "transition": "0.6–1.2s crossfade, retain musical sample phase where possible"
    },
    {
      "id": "L2",
      "name": "后仓夜游",
      "music": "I3_BGM_NightShift_Quiet",
      "transition": "0.6–1.2s crossfade, retain musical sample phase where possible"
    },
    {
      "id": "L3",
      "name": "整店不对劲",
      "music": "I3_BGM_ColdAir",
      "transition": "0.6–1.2s crossfade, retain musical sample phase where possible"
    }
  ],
  "global_rules": {
    "no_event_prerequisite_chain": true,
    "no_task_completion_sounds": true,
    "no_score_or_failure": true,
    "quiet_20_seconds": "ambient pacing only; all interactions immediately available",
    "joke_voice_limit": 1,
    "event_retrigger": "player leaves focus/proximity, then deliberate retrigger after cooldown; no continuous proximity spam",
    "allow_walk_during_performance": true,
    "duck": {
      "bus": "Music",
      "gain_db": -5,
      "attack_s": 0.12,
      "release_s": 0.8,
      "only_on_foreground_jokes": true,
      "not_on_every_footstep": true
    },
    "loop_stop_fade_s": 0.1,
    "do_not_stack_cold_main_quiet": true
  },
  "gag_families": {
    "cow_solemn": {
      "start": [
        "I3_SFX_cow_hmm"
      ],
      "accent": [
        "I3_SFX_cow_welcome"
